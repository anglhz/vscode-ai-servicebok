APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for distributed limits and transfer preview/accept, also Billing.
SUPABASE_SERVICE_ROLE_KEY=
# Hosted Checkout and Customer Portal: server-only test keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# Lookup is optional. See README for the http-json adapter contract.
VEHICLE_PROVIDER=
VEHICLE_API_BASE_URL=
VEHICLE_API_KEY=
# At least 32 random bytes; identical across instances of the same environment.
VEHICLE_LOOKUP_SIGNING_SECRET=
# Environment matrix and staging setup: STAGING.md.
# APP_URL must use HTTPS on Vercel; never derive it from request headers.
# Billing requires all Stripe variables plus service role; none are public.
# Disable optional lookup by leaving all four VEHICLE_* variables empty.
